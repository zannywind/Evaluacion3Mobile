# Plantilla para firmar el APK release. Copia este archivo como "keystore.properties" (mismo
# directorio, junto a gradlew) y completa los valores. keystore.properties está en .gitignore:
# NUNCA lo subas al repositorio. Usa rutas absolutas y sin comillas.
#
#   keytool -genkeypair -v -keystore C:/llaves/mpaz-release.jks -alias mpaz -keyalg RSA -keysize 2048 -validity 10000
MPAZ_STORE_FILE=C:/ruta/absoluta/a/mpaz-release.jks
MPAZ_STORE_PASSWORD=cambia-esta-clave
MPAZ_KEY_ALIAS=mpaz
MPAZ_KEY_PASSWORD=cambia-esta-clave
