<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Consumo de la API REST (modo API) y prueba de conexión del diálogo "Servidor". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Distinguir "el dispositivo no tiene red" de "el servidor no responde" (nativo/EstadoRed). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Recurso nativo: aviso local del resultado del envío (Android 13+, se pide al enviar). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Recurso nativo: vibración corta al confirmar el resultado de un envío. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MpazNotifica">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MpazNotifica">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
